<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>JunkAtCurb — Curbside Pickup, Made Simple</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --yellow:   #F5C400;
      --yellow-lt: #FFF6CC;
      --charcoal: #1C1C1E;
      --body-txt: #3A3A3C;
      --mid-gray: #6E6E73;
      --border:   #E5E5EA;
      --bg-alt:   #F7F7F7;
      --white:    #FFFFFF;
      --red-soft: #FF3B30;

      --font-display: 'Barlow Condensed', sans-serif;
      --font-body:    'Inter', sans-serif;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-body);
      color: var(--body-txt);
      background: var(--white);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    /* ── NAV ── */
    nav {
      background: var(--charcoal);
      padding: 16px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav-logo {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 800;
      color: var(--white);
      letter-spacing: 0.02em;
      text-decoration: none;
    }

    .nav-logo span {
      color: var(--yellow);
    }

    .nav-cta {
      background: var(--yellow);
      color: var(--charcoal);
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 14px;
      padding: 10px 20px;
      border-radius: 6px;
      text-decoration: none;
      transition: opacity 0.15s;
    }

    .nav-cta:hover { opacity: 0.85; }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .nav-phone {
      color: var(--white);
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
    }

    .nav-phone:hover { color: var(--yellow); }

    @media (max-width: 640px) {
      nav { padding: 14px 18px; }
      .nav-actions { gap: 10px; }
      .nav-phone { display: none; }
      .nav-cta { padding: 9px 14px; font-size: 13px; }
    }

    /* ── HERO ── */
    .hero {
      background: var(--charcoal);
      color: var(--white);
      padding: 72px 24px 80px;
      text-align: center;
    }

    .hero-eyebrow {
      font-family: var(--font-body);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--yellow);
      margin-bottom: 20px;
    }

    .hero h1 {
      font-family: var(--font-display);
      font-size: clamp(52px, 12vw, 88px);
      font-weight: 800;
      line-height: 1.0;
      letter-spacing: 0.01em;
      text-transform: uppercase;
      margin-bottom: 24px;
    }

    /* Signature element: curb-mark yellow block highlight */
    .hero h1 .hl {
      background: var(--yellow);
      color: var(--charcoal);
      padding: 0 6px 2px;
      display: inline-block;
      transform: skewX(-2deg);
    }

    .hero-sub {
      font-size: clamp(17px, 3vw, 20px);
      color: #C7C7CC;
      margin-bottom: 36px;
      max-width: 440px;
      margin-left: auto;
      margin-right: auto;
      line-height: 1.5;
    }

    .hero-sub strong {
      color: var(--white);
    }

    .btn-primary {
      display: inline-block;
      background: var(--yellow);
      color: var(--charcoal);
      font-family: var(--font-body);
      font-size: 18px;
      font-weight: 700;
      padding: 18px 40px;
      border-radius: 8px;
      text-decoration: none;
      letter-spacing: 0.01em;
      transition: transform 0.15s, box-shadow 0.15s;
      box-shadow: 0 4px 20px rgba(245,196,0,0.35);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 28px rgba(245,196,0,0.45);
    }

    .hero-note {
      margin-top: 16px;
      font-size: 13px;
      color: #8E8E93;
    }

    /* ── HOW IT WORKS ── */
    .how {
      padding: 72px 24px;
      background: var(--white);
      text-align: center;
    }

    .section-label {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--mid-gray);
      margin-bottom: 10px;
    }

    .section-title {
      font-family: var(--font-display);
      font-size: clamp(32px, 6vw, 48px);
      font-weight: 800;
      text-transform: uppercase;
      color: var(--charcoal);
      margin-bottom: 56px;
      line-height: 1.05;
    }

    .steps {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 32px;
      max-width: 860px;
      margin: 0 auto;
    }

    .step {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
    }

    .step-num {
      width: 52px;
      height: 52px;
      background: var(--yellow);
      color: var(--charcoal);
      font-family: var(--font-display);
      font-size: 26px;
      font-weight: 800;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .step-title {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--charcoal);
      letter-spacing: 0.02em;
    }

    .step p {
      font-size: 15px;
      color: var(--mid-gray);
      max-width: 200px;
      text-align: center;
    }

    /* ── WHY CURBSIDE ── */
    .why-curbside {
      padding: 72px 24px;
      background: var(--yellow-lt);
      text-align: center;
    }

    .benefit-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
      max-width: 860px;
      margin: 0 auto;
    }

    .benefit {
      background: var(--white);
      border: 1.5px solid #F1DD72;
      border-radius: 12px;
      padding: 18px;
      display: flex;
      align-items: center;
      gap: 12px;
      text-align: left;
      color: var(--charcoal);
      font-size: 15px;
    }

    .benefit span { font-size: 24px; }

    /* ── WHAT WE TAKE ── */
    .what {
      background: var(--bg-alt);
      padding: 72px 24px;
      text-align: center;
    }

    .item-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      max-width: 720px;
      margin: 0 auto 48px;
    }

    .item-tag {
      background: var(--white);
      border: 1.5px solid var(--border);
      color: var(--body-txt);
      font-size: 14px;
      font-weight: 500;
      padding: 8px 16px;
      border-radius: 40px;
    }

    .no-list {
      background: var(--white);
      border: 1.5px solid #FFD5D2;
      border-radius: 12px;
      padding: 24px 28px;
      max-width: 480px;
      margin: 0 auto;
      text-align: left;
    }

    .no-list-title {
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--red-soft);
      margin-bottom: 12px;
    }

    .no-list ul {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .no-list ul li {
      font-size: 13px;
      color: var(--mid-gray);
      background: #FFF5F4;
      padding: 5px 12px;
      border-radius: 20px;
    }

    /* ── FORM ── */
    .form-section {
      padding: 80px 24px;
      background: var(--white);
    }

    .form-wrap {
      max-width: 620px;
      margin: 0 auto;
    }

    .form-header {
      text-align: center;
      margin-bottom: 40px;
    }

    .service-callout {
      background: var(--yellow-lt);
      border: 1.5px solid #F1DD72;
      border-radius: 10px;
      padding: 14px 18px;
      margin-top: 18px;
      color: var(--charcoal);
      font-size: 14px;
    }

    .service-callout a {
      color: var(--charcoal);
      font-weight: 700;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    fieldset {
      border: none;
      padding: 0;
    }

    legend {
      font-family: var(--font-display);
      font-size: 17px;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--charcoal);
      letter-spacing: 0.04em;
      margin-bottom: 14px;
      padding-bottom: 8px;
      border-bottom: 2px solid var(--yellow);
      width: 100%;
    }

    .field-group {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    @media (max-width: 480px) {
      .field-group { grid-template-columns: 1fr; }
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field.full { grid-column: 1 / -1; }

    label {
      font-size: 13px;
      font-weight: 600;
      color: var(--charcoal);
      letter-spacing: 0.02em;
    }

    input[type="text"],
    input[type="email"],
    input[type="tel"],
    input[type="date"],
    select,
    textarea {
      font-family: var(--font-body);
      font-size: 15px;
      color: var(--charcoal);
      background: var(--white);
      border: 1.5px solid var(--border);
      border-radius: 8px;
      padding: 12px 14px;
      width: 100%;
      transition: border-color 0.15s, box-shadow 0.15s;
      outline: none;
      appearance: none;
    }

    input:focus, select:focus, textarea:focus {
      border-color: var(--yellow);
      box-shadow: 0 0 0 3px rgba(245,196,0,0.18);
    }

    textarea { resize: vertical; min-height: 90px; }

    .checkbox-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 10px;
    }

    .check-item {
      display: flex;
      align-items: center;
      gap: 9px;
      cursor: pointer;
      font-size: 14px;
      color: var(--body-txt);
    }

    .check-item input[type="checkbox"] {
      width: 18px;
      height: 18px;
      border: 1.5px solid var(--border);
      border-radius: 4px;
      background: var(--white);
      cursor: pointer;
      accent-color: var(--yellow);
      flex-shrink: 0;
    }

    .hazard-box {
      background: #FFFBEB;
      border: 1.5px solid #FBBF24;
      border-radius: 10px;
      padding: 18px 20px;
    }

    .hazard-box legend {
      border-color: #FBBF24;
      color: #92400E;
      font-size: 14px;
    }

    .hazard-warning {
      display: none;
      background: #FEF2F2;
      border: 1.5px solid #FECACA;
      border-radius: 8px;
      padding: 14px 16px;
      font-size: 14px;
      color: #991B1B;
      font-weight: 500;
      margin-top: 14px;
    }

    .upload-area {
      border: 2px dashed var(--border);
      border-radius: 10px;
      padding: 28px 20px;
      text-align: center;
      cursor: pointer;
      transition: border-color 0.15s, background 0.15s;
      position: relative;
    }

    .upload-area:hover {
      border-color: var(--yellow);
      background: var(--yellow-lt);
    }

    .upload-area input[type="file"] {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
      width: 100%;
      height: 100%;
    }

    .upload-icon {
      font-size: 32px;
      margin-bottom: 8px;
      display: block;
    }

    .upload-area p {
      font-size: 14px;
      color: var(--mid-gray);
    }

    .upload-area strong {
      color: var(--charcoal);
      font-weight: 600;
    }

    .file-preview {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
    }

    .file-chip {
      background: var(--yellow-lt);
      border: 1px solid #E9D600;
      border-radius: 20px;
      font-size: 12px;
      padding: 4px 12px;
      color: var(--charcoal);
      font-weight: 500;
    }

    .btn-submit {
      background: var(--yellow);
      color: var(--charcoal);
      font-family: var(--font-body);
      font-size: 18px;
      font-weight: 700;
      padding: 18px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      width: 100%;
      transition: transform 0.15s, box-shadow 0.15s;
      box-shadow: 0 4px 16px rgba(245,196,0,0.3);
      letter-spacing: 0.01em;
    }

    .btn-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(245,196,0,0.4);
    }

    .form-note {
      text-align: center;
      font-size: 13px;
      color: var(--mid-gray);
      margin-top: -8px;
    }

    .quote-disclaimer {
      font-size: 13px;
      color: var(--mid-gray);
      background: var(--bg-alt);
      border-radius: 8px;
      padding: 12px 14px;
      line-height: 1.5;
    }

    /* ── TRUST BAR ── */
    .trust-bar {
      background: var(--charcoal);
      padding: 28px 24px;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 28px 48px;
    }

    .trust-item {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #AEAEB2;
      font-size: 14px;
      font-weight: 500;
    }

    .trust-item span:first-child {
      font-size: 20px;
    }

    /* ── FAQ ── */
    .faq {
      background: var(--bg-alt);
      padding: 72px 24px;
    }

    .faq-wrap {
      max-width: 620px;
      margin: 0 auto;
    }

    .faq-header {
      text-align: center;
      margin-bottom: 40px;
    }

    .faq-item {
      border-bottom: 1.5px solid var(--border);
    }

    .faq-item:first-of-type {
      border-top: 1.5px solid var(--border);
    }

    .faq-q {
      width: 100%;
      background: none;
      border: none;
      text-align: left;
      cursor: pointer;
      padding: 20px 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      font-family: var(--font-body);
      font-size: 16px;
      font-weight: 600;
      color: var(--charcoal);
    }

    .faq-q:focus { outline: 2px solid var(--yellow); outline-offset: 2px; }

    .faq-arrow {
      width: 24px;
      height: 24px;
      background: var(--yellow);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 14px;
      font-weight: 700;
      color: var(--charcoal);
      transition: transform 0.2s;
    }

    .faq-item.open .faq-arrow { transform: rotate(45deg); }

    .faq-a {
      font-size: 15px;
      color: var(--mid-gray);
      padding-bottom: 20px;
      display: none;
      line-height: 1.65;
    }

    .faq-item.open .faq-a { display: block; }

    /* ── FOOTER ── */
    footer {
      background: var(--charcoal);
      color: #8E8E93;
      text-align: center;
      padding: 32px 24px;
      font-size: 13px;
    }

    footer a { color: var(--yellow); text-decoration: none; }
    footer strong { color: var(--white); }

    /* ── SUCCESS STATE ── */
    .success-msg {
      display: none;
      background: #F0FFF4;
      border: 1.5px solid #6EE7A0;
      border-radius: 12px;
      padding: 32px;
      text-align: center;
    }

    .success-msg .s-icon { font-size: 40px; margin-bottom: 12px; }
    .success-msg h3 {
      font-family: var(--font-display);
      font-size: 26px;
      font-weight: 800;
      text-transform: uppercase;
      color: var(--charcoal);
      margin-bottom: 8px;
    }
    .success-msg p { font-size: 15px; color: var(--mid-gray); }

    @media (prefers-reduced-motion: reduce) {
      * { transition: none !important; transform: none !important; }
    }
  </style>
</head>
<body>

  <!-- NAV -->
  <nav>
    <a class="nav-logo" href="#"><span>Junk</span>AtCurb</a>
    <div class="nav-actions">
      <a class="nav-phone" href="tel:4017020009">Call/Text: 401-702-0009</a>
      <a class="nav-cta" href="#quote">Get a Free Quote</a>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <p class="hero-eyebrow">Curbside Junk Pickup</p>
    <h1>Got Junk<br>at the <span class="hl">Curb?</span></h1>
    <p class="hero-sub">
      <strong>Upload a photo. Get a quote. Schedule pickup.</strong><br>
      No dumpster required. No strangers in your home.
    </p>
    <a class="btn-primary" href="#quote">Get My Free Quote</a>
    <p class="hero-note">Quotes returned within 24 hours · No obligation</p>
  </section>

  <!-- TRUST BAR -->
  <div class="trust-bar">
    <div class="trust-item"><span>📸</span><span>Photo-based quotes</span></div>
    <div class="trust-item"><span>🏠</span><span>No home entry required</span></div>
    <div class="trust-item"><span>⚡</span><span>Quotes within 24 hours</span></div>
    <div class="trust-item"><span>📍</span><span>Serving all of Rhode Island</span></div>
  </div>

  <!-- HOW IT WORKS -->
  <section class="how">
    <p class="section-label">Simple Process</p>
    <h2 class="section-title">Here's How It Works</h2>
    <div class="steps">
      <div class="step">
        <div class="step-num">1</div>
        <div class="step-title">Put It at the Curb</div>
        <p>Move your unwanted items to the curb or an agreed spot outside.</p>
      </div>
      <div class="step">
        <div class="step-num">2</div>
        <div class="step-title">Upload Photos</div>
        <p>Snap a few pictures so we can see exactly what needs to go.</p>
      </div>
      <div class="step">
        <div class="step-num">3</div>
        <div class="step-title">Get a Quote</div>
        <p>We review your photos and send you fair, upfront pricing.</p>
      </div>
      <div class="step">
        <div class="step-num">4</div>
        <div class="step-title">Schedule Pickup</div>
        <p>Approve the quote and we'll handle the rest.</p>
      </div>
    </div>
  </section>



  <!-- WHY CURBSIDE -->
  <section class="why-curbside">
    <p class="section-label">Why Curbside?</p>
    <h2 class="section-title">Easy for You. Safer for Everyone.</h2>
    <div class="benefit-grid">
      <div class="benefit"><span>🏠</span><strong>No strangers entering your home</strong></div>
      <div class="benefit"><span>📸</span><strong>Simple photo-based quotes</strong></div>
      <div class="benefit"><span>⏰</span><strong>No waiting around for crews</strong></div>
      <div class="benefit"><span>🚫</span><strong>No dumpster rental required</strong></div>
      <div class="benefit"><span>✅</span><strong>Easy contactless pickup</strong></div>
      <div class="benefit"><span>⚡</span><strong>Faster scheduling</strong></div>
    </div>
  </section>

  <!-- WHAT WE TAKE -->
  <section class="what">
    <p class="section-label">Accepted Items</p>
    <h2 class="section-title">We Take Most Things</h2>
    <div class="item-grid">
      <span class="item-tag">🛋️ Furniture</span>
      <span class="item-tag">🧺 Appliances</span>
      <span class="item-tag">📺 Electronics</span>
      <span class="item-tag">🌿 Yard Waste</span>
      <span class="item-tag">🔩 Scrap Metal</span>
      <span class="item-tag">🚜 Lawn Equipment</span>
      <span class="item-tag">📦 Household Clutter</span>
      <span class="item-tag">📋 Cardboard</span>
      <span class="item-tag">🏋️ Exercise Equipment</span>
      <span class="item-tag">🚗 Bulk Items</span>
      <span class="item-tag">🏗️ Construction Debris</span>
    </div>

    <div class="no-list">
      <p class="no-list-title">⚠️ We Do Not Accept</p>
      <ul>
        <li>Paint</li>
        <li>Motor oil</li>
        <li>Antifreeze</li>
        <li>Chemicals</li>
        <li>Sharps / needles</li>
        <li>Batteries</li>
        <li>Hazardous waste</li>
        <li>Biohazards</li>
      </ul>
    </div>
  </section>

  <!-- QUOTE FORM -->
  <section class="form-section" id="quote">
    <div class="form-wrap">
      <div class="form-header">
        <p class="section-label">Free Quote</p>
        <h2 class="section-title" style="margin-bottom:8px;">Request a Pickup Quote</h2>
        <p style="color:var(--mid-gray);font-size:15px;">Not sure if we'll take it? Upload a photo anyway. We'll review your request and let you know.</p>
        <div class="service-callout">
          <strong>Serving all of Rhode Island</strong><br>
          Questions? Call or text <a href="tel:4017020009">401-702-0009</a>
        </div>
      </div>

      <!-- Replace YOUR_FORM_ID with your Formspree endpoint -->
      <form id="quoteForm" action="https://formspree.io/f/xykajlvy" method="POST" enctype="multipart/form-data" novalidate>

        <!-- Contact -->
        <fieldset>
          <legend>Your Info</legend>
          <div class="field-group">
            <div class="field">
              <label for="name">Full Name *</label>
              <input type="text" id="name" name="name" placeholder="Jane Smith" required />
            </div>
            <div class="field">
              <label for="phone">Phone Number *</label>
              <input type="tel" id="phone" name="phone" placeholder="(555) 000-0000" required />
            </div>
            <div class="field">
              <label for="email">Email Address *</label>
              <input type="email" id="email" name="email" placeholder="jane@email.com" required />
            </div>
            <div class="field">
              <label for="address">Street Address *</label>
              <input type="text" id="address" name="address" placeholder="123 Main St, City, State" required />
            </div>
          </div>
        </fieldset>

        <!-- Photos -->
        <fieldset>
          <legend>Upload Photos</legend>
          <div class="upload-area" id="uploadArea">
            <input type="file" name="photos" accept="image/*" multiple id="photoInput" aria-label="Upload up to 5 photos" />
            <span class="upload-icon">📷</span>
            <p><strong>Tap to upload photos</strong><br>Up to 5 photos · JPG, PNG, HEIC</p>
          </div>
          <div class="file-preview" id="filePreview"></div>
        </fieldset>

        <!-- Item Details -->
        <fieldset>
          <legend>What Needs to Go?</legend>
          <div class="field-group">
            <div class="field full">
              <label for="description">Describe what you're getting rid of</label>
              <textarea id="description" name="description" placeholder="e.g. Old couch, a few boxes, broken lawn chairs…"></textarea>
            </div>
            <div class="field">
              <label for="quantity">Quantity</label>
              <select id="quantity" name="quantity">
                <option value="">Select quantity…</option>
                <option>1 item</option>
                <option>2–5 items</option>
                <option>Small pile</option>
                <option>Large pile</option>
              </select>
            </div>
            <div class="field">
              <label for="pickup_date">Preferred Pickup Date</label>
              <input type="date" id="pickup_date" name="pickup_date" />
            </div>
          </div>
        </fieldset>

        <!-- Item Categories -->
        <fieldset>
          <legend>Item Categories</legend>
          <div class="checkbox-grid">
            <label class="check-item"><input type="checkbox" name="category" value="Furniture" /> Furniture</label>
            <label class="check-item"><input type="checkbox" name="category" value="Appliances" /> Appliances</label>
            <label class="check-item"><input type="checkbox" name="category" value="Electronics" /> Electronics</label>
            <label class="check-item"><input type="checkbox" name="category" value="Yard Equipment" /> Yard Equipment</label>
            <label class="check-item"><input type="checkbox" name="category" value="Yard Waste" /> Yard Waste</label>
            <label class="check-item"><input type="checkbox" name="category" value="Scrap Metal" /> Scrap Metal</label>
            <label class="check-item"><input type="checkbox" name="category" value="Household Items" /> Household Items</label>
            <label class="check-item"><input type="checkbox" name="category" value="Construction Debris" /> Construction Debris</label>
            <label class="check-item"><input type="checkbox" name="category" value="Other" /> Other</label>
          </div>
        </fieldset>

        <!-- Special Items -->
        <fieldset>
          <legend>Any Special Items? <span style="font-size:12px;font-weight:500;text-transform:none;letter-spacing:0;color:var(--mid-gray)">(may require additional pricing)</span></legend>
          <div class="checkbox-grid">
            <label class="check-item"><input type="checkbox" name="special" value="Mattress" /> Mattress</label>
            <label class="check-item"><input type="checkbox" name="special" value="Tire(s)" /> Tire(s)</label>
            <label class="check-item"><input type="checkbox" name="special" value="Refrigerator / Freezer" /> Fridge / Freezer</label>
            <label class="check-item"><input type="checkbox" name="special" value="Air Conditioner" /> Air Conditioner</label>
            <label class="check-item"><input type="checkbox" name="special" value="Television" /> Television</label>
            <label class="check-item"><input type="checkbox" name="special" value="Exercise Equipment" /> Exercise Equipment</label>
            <label class="check-item"><input type="checkbox" name="special" value="Playset" /> Playset</label>
            <label class="check-item"><input type="checkbox" name="special" value="Large Debris Pile" /> Large Debris Pile</label>
            <label class="check-item"><input type="checkbox" name="special" value="Other Oversized Item" /> Other Oversized</label>
          </div>
        </fieldset>

        <!-- Hazardous Materials -->
        <fieldset class="hazard-box">
          <legend>⚠️ Hazardous Materials Check</legend>
          <p style="font-size:14px;color:#92400E;margin-bottom:14px;">Does your request include any of the following?</p>
          <div class="checkbox-grid" id="hazardChecks">
            <label class="check-item"><input type="checkbox" name="hazard" value="Paint" class="hazard-check" /> Paint</label>
            <label class="check-item"><input type="checkbox" name="hazard" value="Oil" class="hazard-check" /> Motor Oil</label>
            <label class="check-item"><input type="checkbox" name="hazard" value="Chemicals" class="hazard-check" /> Chemicals</label>
            <label class="check-item"><input type="checkbox" name="hazard" value="Batteries" class="hazard-check" /> Batteries</label>
            <label class="check-item"><input type="checkbox" name="hazard" value="Sharps" class="hazard-check" /> Sharps / Needles</label>
            <label class="check-item"><input type="checkbox" name="hazard" value="None" id="noneOfThese" /> None of These</label>
          </div>
          <div class="hazard-warning" id="hazardWarning">
            ⛔ We do not currently accept hazardous materials. Please check "None of These" to continue, or remove those items from your request.
          </div>
        </fieldset>

        <p class="quote-disclaimer">Submission of a quote request does not guarantee acceptance. All requests are reviewed individually. Items must be placed at the curb, driveway edge, or other agreed outdoor pickup location before pickup.</p>

        <button type="submit" class="btn-submit" id="submitBtn">Send My Quote Request →</button>
        <p class="form-note">No payment required. We'll review and respond within 24 hours.</p>
      </form>

      <div class="success-msg" id="successMsg">
        <div class="s-icon">🎉</div>
        <h3>Quote Request Sent!</h3>
        <p>We'll review your photos and get back to you within 24 hours with pricing. Keep an eye on your inbox, or call/text us at 401-702-0009 with questions.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="faq-wrap">
      <div class="faq-header">
        <p class="section-label">Questions</p>
        <h2 class="section-title">FAQ</h2>
      </div>

      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">
          How much does pickup cost?
          <span class="faq-arrow">+</span>
        </button>
        <div class="faq-a">Pricing depends on the item, quantity, and location. Submit a few photos using our free quote form and we'll give you upfront pricing — no surprises.</div>
      </div>

      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">
          Do I need to be home for pickup?
          <span class="faq-arrow">+</span>
        </button>
        <div class="faq-a">Usually not. As long as your items are accessible at the curb, we can typically handle the pickup without you needing to be there.</div>
      </div>



      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">
          Do I need to move the items to the curb?
          <span class="faq-arrow">+</span>
        </button>
        <div class="faq-a">Yes. Items must be placed at the curb, driveway edge, or another agreed outdoor pickup location before pickup. We do not enter homes, garages, sheds, or backyards.</div>
      </div>

      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">
          What items can you pick up?
          <span class="faq-arrow">+</span>
        </button>
        <div class="faq-a">We handle most common household, outdoor, and bulk items — furniture, appliances, electronics, yard debris, scrap metal, exercise equipment, and more. Not every item is guaranteed, which is why we review each request individually.</div>
      </div>

      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">
          How quickly will I get a quote?
          <span class="faq-arrow">+</span>
        </button>
        <div class="faq-a">Typically within 24 hours of receiving your request and photos.</div>
      </div>

      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">
          What's different about JunkAtCurb?
          <span class="faq-arrow">+</span>
        </button>
        <div class="faq-a">Traditional junk haulers come into your home and carry things out. We keep it simple: you put it at the curb, we take it from there. No strangers in your house, no complicated scheduling, no dumpster needed.</div>
      </div>

      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">
          What items do you not accept?
          <span class="faq-arrow">+</span>
        </button>
        <div class="faq-a">We do not accept hazardous materials of any kind — including paint, motor oil, antifreeze, chemicals, sharps or needles, batteries, or biohazardous waste. If you're not sure, just ask in the description field and we'll let you know.</div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <p><strong>JunkAtCurb</strong></p>
    <p style="margin-top:8px;"><a href="tel:4017020009">401-702-0009</a> · <a href="mailto:junkatcurb@gmail.com">junkatcurb@gmail.com</a></p>
    <p style="margin-top:8px;">Curbside pickup made simple · Serving all of Rhode Island</p>
    <p style="margin-top:16px;">© 2026 JunkAtCurb. All rights reserved.</p>
  </footer>

  <script>
    // File upload preview
    const photoInput = document.getElementById('photoInput');
    const filePreview = document.getElementById('filePreview');

    photoInput.addEventListener('change', () => {
      filePreview.innerHTML = '';
      const files = Array.from(photoInput.files).slice(0, 5);
      files.forEach(f => {
        const chip = document.createElement('span');
        chip.className = 'file-chip';
        chip.textContent = '📎 ' + f.name;
        filePreview.appendChild(chip);
      });
    });

    // Hazardous materials warning
    const hazardChecks = document.querySelectorAll('.hazard-check');
    const noneCheck = document.getElementById('noneOfThese');
    const hazardWarning = document.getElementById('hazardWarning');
    const submitBtn = document.getElementById('submitBtn');

    function updateHazard() {
      const anyChecked = Array.from(hazardChecks).some(c => c.checked);
      hazardWarning.style.display = anyChecked ? 'block' : 'none';
      submitBtn.disabled = anyChecked;
      submitBtn.style.opacity = anyChecked ? '0.5' : '1';
      submitBtn.style.cursor = anyChecked ? 'not-allowed' : 'pointer';
    }

    hazardChecks.forEach(c => c.addEventListener('change', updateHazard));

    noneCheck.addEventListener('change', () => {
      if (noneCheck.checked) {
        hazardChecks.forEach(c => { c.checked = false; });
        updateHazard();
      }
    });

    // FAQ accordion
    document.querySelectorAll('.faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.faq-item');
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
        document.querySelectorAll('.faq-q').forEach(b => b.setAttribute('aria-expanded', 'false'));
        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // Form submission (Formspree AJAX)
    const form = document.getElementById('quoteForm');
    const successMsg = document.getElementById('successMsg');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.textContent = 'Sending…';
      submitBtn.disabled = true;

      try {
        const data = new FormData(form);
        const res = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { 'Accept': 'application/json' }
        });

        if (res.ok) {
          form.style.display = 'none';
          successMsg.style.display = 'block';
          window.scrollTo({ top: document.getElementById('quote').offsetTop - 80, behavior: 'smooth' });
        } else {
          submitBtn.textContent = 'Send My Quote Request →';
          submitBtn.disabled = false;
          alert('Something went wrong. Please try again or email us directly.');
        }
      } catch {
        submitBtn.textContent = 'Send My Quote Request →';
        submitBtn.disabled = false;
        alert('Network error. Please try again.');
      }
    });
  </script>
</body>
